# RUN: %clang -O0 -Werror=return-type -mllvm -verify-machineinstrs -S %root/libp2/lib/builtins/ashldi3.c -o %t.O0.s
# RUN: FileCheck %s < %t.O0.s
# RUN: %clang -O2 -Werror=return-type -mllvm -verify-machineinstrs -S %root/libp2/lib/builtins/ashldi3.c -o %t.O2.s
# RUN: FileCheck %s < %t.O2.s
